{
  "name": "novel-brain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "turbo dev",
    "demo:m0": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/m0-demo.ps1",
    "demo:m1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/m1-demo.ps1",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "vitest run --maxWorkers=4",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @novel/db db:generate",
    "db:migrate": "pnpm --filter @novel/db db:migrate",
    "db:seed": "pnpm --filter @novel/db db:seed",
    "demo:m2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/m2-demo.ps1"
  },
  "pnpm": {
    "overrides": {
      "decode-uri-component": "0.5.1",
      "stream-json": "1.9.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.21",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jszip": "3.10.1",
    "minio": "8.0.7",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
