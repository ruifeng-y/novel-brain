{
  "name": "@novel-brain/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- openapi.json src/generated/openapi.d.ts",
    "openapi:generate": "pnpm build && node dist/generate-openapi.js && prettier --write openapi.json && openapi-typescript openapi.json -o src/generated/openapi.d.ts && prettier --write src/generated/openapi.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@node-rs/argon2": "2.2.2",
    "@novel-brain/ai": "workspace:*",
    "@novel-brain/contracts": "workspace:*",
    "@novel-brain/core": "workspace:*",
    "@novel-brain/db": "workspace:*",
    "@novel-brain/golden-three": "workspace:*",
    "bullmq": "6.6.0",
    "drizzle-orm": "0.45.4",
    "express": "^5.0.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.3.1",
    "pino": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "8.0.2",
    "openapi-typescript": "7.13.0"
  }
}
