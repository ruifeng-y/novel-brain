                    },
                    "requestId": {
                      "type": "string",
                      "format": "starts_with",
                      "pattern": "^req_.*"
                    },
                    "meta": {
                      "default": {},
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": ["data", "requestId", "meta"],
                  "additionalProperties": false
                }
              }
            }
          }
