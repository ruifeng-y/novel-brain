                        },
                        "checks": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "enum": ["database", "queue"]
                              },
                              "status": {
                                "type": "string",
                                "enum": ["up", "down"]
                              },
                              "latencyMs": {
                                "type": "number",
                                "minimum": 0
                              }
                            },
                            "required": ["name", "status", "latencyMs"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["status", "service", "timestamp", "checks"],
