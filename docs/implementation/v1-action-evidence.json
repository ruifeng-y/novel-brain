          "id": "blank-work",
          "name": "创建空白作品并持久化来源模式",
          "api": "/api/v1/works",
          "spec": "apps/web/e2e/parity/new-project.spec.ts",
          "test": "creates a blank work without an idea and persists it",
          "assertion": "expect(persistedWork.sourceMode).toBe(\"blank\");"
        },
        {
          "id": "genre-template",
          "name": "创建题材模板作品并持久化题材包",
