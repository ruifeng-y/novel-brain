          "spec": "apps/web/e2e/parity/new-project.spec.ts",
          "test": "imports an old manuscript and persists chapter order and content",
          "assertion": "expect(persistedManuscript).toContain(\"夜船顺流而下。\");"
        },
        {
          "id": "import-conflict-resolution",
          "name": "裁决设定冲突后再创建作品并持久化选择",
          "api": "/api/v1/imports/${settingsImport.id}/conflicts/${conflict.id}/decision",
          "spec": "apps/web/e2e/parity/new-project.spec.ts",
          "test": "persists a settings conflict decision before creating the work",
          "assertion": "expect(character.data.bodyState).toBe(\"外门杂役，左臂骨折。\");"
        },
        {
          "id": "create-blueprint",
          "name": "将作品创建为可继续写作的主创作线蓝图",
          "api": "/api/v1/works",
          "spec": "apps/web/e2e/parity/new-project.spec.ts",
          "test": "creates a work from an idea and persists its blueprint",
          "assertion": "expect(persistedWork.mainBranch.headNodeId).toMatch(/^[0-9a-f-]{36}$/);"
        }
      ]
