POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql://novelbrain:replace-with-long-random-password@postgres:5432/novelbrain
REDIS_URL=redis://redis:6379

AUTH_SECRET=replace-with-at-least-32-random-characters
PROXY_IP_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://novelbrain.example.com
LOG_RETENTION_DAYS=30

MODEL_CONFIG_ENCRYPTION_KEY=replace-with-32-byte-key-1234567
MODEL_PROVIDER_ALLOWLIST=https://api.deepseek.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
MAIL_FROM=NovelBrain <no-reply@example.com>

STORAGE_ACCESS_KEY_ID=replace-with-storage-user
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-password
STORAGE_BUCKET=novelbrain
BACKUP_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-random-key
