# Copy to a restricted deployment environment file; never commit real values.
APP_DOMAIN=novelbrain.example.com
ACME_EMAIL=ops@example.com
PUBLIC_WEB_URL=https://novelbrain.example.com

POSTGRES_PASSWORD=replace-with-a-strong-owner-password
DATABASE_URL=postgres://novel_app:replace-with-a-strong-app-password@postgres:5432/novel
DATABASE_ADMIN_URL=postgres://novel:replace-with-a-strong-owner-password@postgres:5432/novel
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379

MINIO_ROOT_USER=replace-with-a-production-access-key
MINIO_ROOT_PASSWORD=replace-with-a-production-secret-key
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=novel-brain

SESSION_SECRET=replace-with-a-random-64-character-session-secret
MODEL_KEY_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
DOWNLOAD_SIGNING_SECRET=replace-with-a-different-random-64-character-secret
DOWNLOAD_URL_TTL_SECONDS=300

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@novelbrain.example.com
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_TLS_MIN_VERSION=TLSv1.2

TRUST_PROXY_HOPS=1
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

# Set both only after verifying encrypted disks/buckets and a successful offsite restore.
ENCRYPTION_AT_REST_CONFIRMED=false
OFFSITE_BACKUP_CONFIRMED=false
